<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs project decisions: a rule, or a rule in part of the code, that the team has decided not
     to enforce. One Match per decision, with a comment giving the reason, for example:

       <!- - JPA entities share associations by design (reason ...) - ->
       <Match><Package name="~team\.projectpulse\..*"/><Bug pattern="EI_EXPOSE_REP"/></Match>

     Unlike the baseline, this file may grow, but every entry is a reviewed decision. -->
<FindBugsFilter>
  <!-- Hibernate owns persistence-entity associations and proxies; copying an
       entity reference or relationship collection can detach managed state. -->
  <Match>
    <Class annotation="jakarta.persistence.Entity"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Transport DTOs intentionally expose their mutable payload for JSON
       serialization. They are not domain ownership boundaries. -->
  <Match>
    <Class name="~team\.projectpulse\..*\.dto\..*"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Controllers, services, and schedulers are Spring-managed components.
       Their collaborators are shared dependency-injection singletons, which
       must be retained by identity rather than defensively copied. -->
  <Match>
    <Class annotation="org.springframework.stereotype.Component"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class annotation="org.springframework.stereotype.Service"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class annotation="org.springframework.web.bind.annotation.RestController"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- These five classes are boundary models: JSON report/template payloads,
       an immutable reminder result, and Spring Security's identity wrapper.
       Their references intentionally preserve identity for serialization or
       authentication; this exception does not apply to other model classes. -->
  <Match>
    <Class name="team.projectpulse.evaluation.PeerEvaluationAverage"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="team.projectpulse.evaluation.WeeklyPeerEvaluationReport"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="team.projectpulse.notification.ReminderService$ReminderResult"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="team.projectpulse.ram.document.template.DocumentTemplate"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="team.projectpulse.user.MyUserPrincipal"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
